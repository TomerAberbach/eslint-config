{
  "name": "@tomer/eslint-config",
  "version": "7.0.0",
  "author": {
    "name": "Tomer Aberbach",
    "email": "tomer@aberba.ch",
    "url": "https://tomeraberba.ch"
  },
  "description": "My ESLint configuration!",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "lint",
    "configuration",
    "config"
  ],
  "homepage": "https://github.com/TomerAberbach/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomerAberbach/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/TomerAberbach/eslint-config/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/TomerAberbach"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format:base": "prettier --cache --write",
    "format": "pnpm format:base .",
    "lint:base": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint": "pnpm lint:base .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "build": "tsdown",
    "check": "run-p -c -l typecheck \"lint --no-fix\" \"format --no-write --check\" knip \"test --run\"",
    "prepublishOnly": "pnpm build"
  },
  "prettier": "@tomer/prettier-config",
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/markdown": "^9.0.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.3.3",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-testing-library": "^7.16.3",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.74.0"
  },
  "peerDependencies": {
    "eslint": "^10.4",
    "typescript": "^6"
  },
  "devDependencies": {
    "@tomer/prettier-config": "^5.0.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^22.20.7",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "knip": "^6.48.0",
    "npm-run-all2": "^9.1.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
