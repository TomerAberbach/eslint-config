{
  "name": "@tomer/eslint-config",
  "version": "5.1.1",
  "author": {
    "name": "Tomer Aberbach",
    "email": "tomer@aberba.ch",
    "url": "https://tomeraberba.ch"
  },
  "description": "My ESLint configuration!",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "lint",
    "configuration",
    "config"
  ],
  "homepage": "https://github.com/TomerAberbach/eslint-config",
  "repository": "TomerAberbach/eslint-config",
  "bugs": {
    "url": "https://github.com/TomerAberbach/eslint-config/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/TomerAberbach"
  },
  "license": "MIT",
  "files": [
    "src/index.js"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || >= 24.15.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format:base": "prettier --cache --write",
    "format": "pnpm format:base .",
    "lint:base": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint": "pnpm lint:base .",
    "knip": "knip",
    "test": "vitest",
    "check": "run-s -c \"lint --no-fix\" \"format --no-write --check\" knip \"test --run\""
  },
  "prettier": "@tomer/prettier-config",
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "eslint": "^10.4",
    "typescript": "^6"
  },
  "devDependencies": {
    "@tomer/prettier-config": "^4.0.1",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
